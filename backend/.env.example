# Server
PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/bmo-chatbot

# Chat brain, tried in this order:
# 1. Ollama (local LLM) - free, no limits, private, but only reachable when
#    running on YOUR machine with Ollama installed. Great for local dev.
# 2. Gemini (cloud API) - used automatically when Ollama isn't reachable,
#    e.g. once this is deployed to a cloud host that doesn't have Ollama.
#    Free tier, get a key at https://aistudio.google.com (no card needed).
# 3. Canned responses - used if neither of the above works.

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

GEMINI_API_KEY=

# Frontend origin, for CORS
CLIENT_ORIGIN=http://localhost:5173
