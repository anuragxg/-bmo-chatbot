# Server
PORT=5000

# MongoDB connection string (local or Atlas) - optional, chat works without it
MONGO_URI=mongodb://localhost:27017/bmo-chatbot

# Chat brain: Ollama (local LLM) - free, no API key, no rate limits, private.
# Install from https://ollama.com, then:  ollama pull llama3.2
# If Ollama isn't reachable, BMO falls back to canned responses (and logs why).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Frontend origin, for CORS
CLIENT_ORIGIN=http://localhost:5173
